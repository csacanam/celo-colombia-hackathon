# --- Airtable ---
# Personal access token con scope data.records:write sobre la base.
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxx
# ID de la base (empieza con "app").
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
# Nombre exacto de la tabla.
AIRTABLE_TABLE_NAME=Hackathon Leads

# --- WhatsApp ---
# Link de invitacion al grupo. Se usa para el redirect post-registro.
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXX

# --- Sitio ---
# Opcional. Solo cuando tengas el dominio final (afecta og:image / canonical).
# Si no se define, en Vercel se usa la URL del deploy automaticamente.
# NEXT_PUBLIC_SITE_URL=https://agentesonchain.co
