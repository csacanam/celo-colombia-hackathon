# --- Airtable ---
# Personal access token con scope data.records:write sobre la base.
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxxxxx
# ID de la base (empieza con "app").
AIRTABLE_BASE_ID=appxxxxxxxxxxxxxx
# Nombre exacto de la tabla.
AIRTABLE_TABLE_NAME=Hackathon Leads

# --- Airtable Demo Day (entregas de los equipos) ---
# Token, base y tabla donde caen las entregas. El portal del jurado lee de aquí.
AIRTABLE_DEMODAY_API_KEY=pat_xxxxxxxxxxxxxxxx
AIRTABLE_DEMODAY_BASE_ID=appxxxxxxxxxxxxxx
AIRTABLE_DEMODAY_TABLE_NAME=Demo Day
# Tabla donde se guardan las evaluaciones del jurado (misma base que Demo Day).
AIRTABLE_EVALS_TABLE_NAME=Evaluaciones

# --- Portal del jurado ---
# Mapa token -> nombre del jurado (JSON en una sola línea). Cada jurado entra
# con su enlace privado: /jurado?token=SU_TOKEN. El nombre atribuye la evaluación.
# Incluye también un token de "Organización" para abrir el deck de Demo Day
# (/slides/demo-day?token=...), que muestra proyectos y el podio automático.
JURY_TOKENS={"TOKEN_SECRETO_1":"Nombre Jurado 1","TOKEN_SECRETO_2":"Nombre Jurado 2","TOKEN_ORG":"Organización"}

# --- WhatsApp ---
# Link de invitacion al grupo. Se usa para el redirect post-registro.
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXX

# --- Sitio ---
# Opcional. Solo cuando tengas el dominio final (afecta og:image / canonical).
# Si no se define, en Vercel se usa la URL del deploy automaticamente.
# NEXT_PUBLIC_SITE_URL=https://agentesonchain.co
